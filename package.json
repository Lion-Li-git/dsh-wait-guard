{
  "name": "dsh-wait-guard",
  "version": "0.3.0",
  "description": "Bounded waiting and no-progress polling breaker for DeepSeek Harness: caps job_output wait budgets, refuses runaway foreground commands nested in run_code, explains run_code deadlines and parse errors, and stops status-polling or no-op run_code loops after a few no-progress calls. 让「等」「轮询」和「空调用」都有刹车。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-0"
  },
  "peerDependencies": {
    "cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0",
    "@deepseek-ai/dsh-jobs": ">=0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node --check src/index.js",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "jobs",
    "background",
    "timeout",
    "polling",
    "loop",
    "status",
    "guard",
    "plugin",
    "noop"
  ],
  "license": "MIT"
}
